{
  "expo": {
    "name": "KD TAXI",
    "slug": "kd-taxi",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kd-taxi",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kdtaxi.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Usado para foto do perfil.",
        "NSPhotoLibraryUsageDescription": "Usado para selecionar foto do perfil.",
        "NSMicrophoneUsageDescription": "N\u00e3o utilizado."
      }
    },
    "android": {
      "package": "com.kdtaxi.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "title": "KD TAXI \u2014 Chame seu t\u00e1xi agora",
      "description": "KD TAXI \u00e9 o aplicativo de transporte para sua cidade. Chame um motorista em segundos, acompanhe em tempo real e pague um pre\u00e7o justo.",
      "themeColor": "#0D0D0D",
      "backgroundColor": "#0D0D0D",
      "lang": "pt-BR"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0D"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F5C518",
          "sounds": [
            "./assets/sounds/ride_alert.wav",
            "./assets/sounds/chat_message.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso \u00e0s fotos para foto do perfil.",
          "cameraPermission": "Permitir acesso \u00e0 c\u00e2mera para foto do perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "5fb3cb5d-d1c2-4bf7-b2a7-aef44055f44a"
      }
    },
    "owner": "leomarkss"
  }
}
