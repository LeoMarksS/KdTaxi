{
  "expo": {
    "name": "KD TAXI",
    "slug": "kd-taxi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kd-taxi",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kdtaxi.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Usado para foto do perfil.",
        "NSPhotoLibraryUsageDescription": "Usado para selecionar foto do perfil.",
        "NSMicrophoneUsageDescription": "Não utilizado."
      }
    },
    "android": {
      "package": "com.kdtaxi.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE", "RECEIVE_BOOT_COMPLETED", "VIBRATE"]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "title": "KD TAXI — Chame seu táxi agora",
      "description": "KD TAXI é o aplicativo de transporte para sua cidade. Chame um motorista em segundos, acompanhe em tempo real e pague um preço justo.",
      "themeColor": "#0D0D0D",
      "backgroundColor": "#0D0D0D",
      "lang": "pt-BR"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F5C518",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso às fotos para foto do perfil.",
          "cameraPermission": "Permitir acesso à câmera para foto do perfil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
