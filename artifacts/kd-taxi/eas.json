{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "20.19.4",
      "pnpm": "10.26.1"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "20.19.4",
      "pnpm": "10.26.1",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "kdtaxi-api.onrender.com",
        "EXPO_PUBLIC_API_URL": "https://kdtaxi-api.onrender.com/api",
        "VITE_API_URL": "https://kdtaxi-api.onrender.com/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "node": "20.19.4",
      "pnpm": "10.26.1"
    }
  },
  "submit": {
    "production": {}
  }
}
